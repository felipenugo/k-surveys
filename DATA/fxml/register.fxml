<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<StackPane styleClass="root-pane" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           stylesheets="/css/register.css">

    <!-- Contenedor para centrar el contenido y el espacio entre los elementos -->
    <!-- El ancho lo definirán los hijos, espacio de 20 vertical entre ellos -->
    <VBox alignment="CENTER" fillWidth="false" spacing="20">

        <!-- CARD DE ERROR -->
        <!-- Inicialmente, no visible, mostrará un mensaje cuando se produzca un error -->
        <!-- No se tiene en cuenta en el layout para centrar correctamente el login y que no quede más abajo -->
        <HBox fx:id="errorCard" alignment="CENTER_LEFT" spacing="10" styleClass="error-card" visible="false" managed="false">
            <Label styleClass="error-icon" text="⚠"/>
            <Label fx:id="errorLabel" styleClass="error-label" wrapText="true" HBox.hgrow="ALWAYS" text=""/>
        </HBox>

        <!-- CARD DE REGISTRO -->
        <VBox alignment="CENTER" spacing="15" styleClass="register-card">
            <Label styleClass="titulo" text="K-Surveys"/>
            <Label styleClass="subtitulo" text="Introduce tus datos para registrarte">
                <VBox.margin>
                    <Insets bottom="20.0"/>
                </VBox.margin>
            </Label>

            <!-- Username -->
            <TextField fx:id="usernameField" promptText="Introduce tu usuario" styleClass="input-field, icon-user"/>

            <!-- Email -->
            <TextField fx:id="emailField" promptText="Introduce tu correo electrónico" styleClass="input-field, icon-email"/>

            <!-- Contraseña -->
            <StackPane>
                <TextField fx:id="passwordText" managed="false" promptText="Introduce tu contraseña"
                           styleClass="input-field, icon-lock" visible="false"/>
                <PasswordField fx:id="passwordField" promptText="Introduce tu contraseña"
                               styleClass="input-field, icon-lock"/>
            </StackPane>

            <!-- Confirmar Contraseña -->
            <StackPane>
                <TextField fx:id="confirmPasswordText" managed="false" promptText="Confirma tu contraseña"
                           styleClass="input-field, icon-lock" visible="false"/>
                <PasswordField fx:id="confirmPasswordField" promptText="Confirma tu contraseña"
                               styleClass="input-field, icon-lock"/>
            </StackPane>

            <!-- Checkbox Mostrar Contraseña -->
            <HBox alignment="CENTER_LEFT" spacing="10">
                <CheckBox fx:id="showPasswordCheck" text="Mostrar contraseñas" onAction="#toggleRegisterPasswords" textFill="gray"/>
            </HBox>

            <!-- Pregunta de Seguridad -->
            <TextField fx:id="securityQuestionField"
                    promptText="Introduce tu pregunta de seguridad"
                    styleClass="input-field"/>

            <!-- Respuesta de Seguridad -->
            <TextField fx:id="securityAnswerField"
                    promptText="Introduce la respuesta de seguridad"
                    styleClass="input-field"/>

            <!-- Botón Registro -->
            <Button onAction="#handleRegister" styleClass="register-button" text="REGISTRARSE">
                <VBox.margin>
                    <Insets top="15.0"/>
                </VBox.margin>
            </Button>

            <!-- Link Login -->
            <HBox alignment="CENTER" spacing="5" >
                <Label text="¿Ya tienes cuenta?" textFill="gray"/>
                <Hyperlink text="Inicia sesión" onAction="#goToLogin"/>
            </HBox>
        </VBox>
    </VBox>

</StackPane>