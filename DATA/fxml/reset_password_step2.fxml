<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<StackPane styleClass="root-pane"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           stylesheets="/css/register.css">

    <VBox alignment="CENTER" fillWidth="false" spacing="20">

        <HBox fx:id="errorCard" visible="false" managed="false" spacing="10" styleClass="error-card">
            <Label styleClass="error-icon" text="⚠"/>
            <Label fx:id="errorLabel" wrapText="true" styleClass="error-label"/>
        </HBox>

        <VBox alignment="CENTER" spacing="15" styleClass="auth-card">

            <Label styleClass="title" text="Pregunta de seguridad"/>

            <Label fx:id="questionLabel" styleClass="subtitle" wrapText="true"/>

            <TextField fx:id="answerField"
                       promptText="Escribe tu respuesta"
                       styleClass="input-field, icon-lock"/>

            <Button text="Validar respuesta" onAction="#handleValidate"
                    styleClass="auth-button"/>

            <Hyperlink text="Volver" onAction="#goBack"/>
        </VBox>
    </VBox>
</StackPane>
