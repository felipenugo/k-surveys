<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- Contenedor raíz -->
<?import javafx.geometry.Insets?>
<StackPane styleClass="root-pane" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           stylesheets="/css/login.css">
    <!-- Contenedor para centrar el contenido y el espacio entre los elementos -->
    <!-- El ancho lo definirán los hijos, espacio de 20 vertical entre ellos -->
    <VBox alignment="CENTER" fillWidth="false" spacing="20">

        <!-- CARD DE ERROR -->
        <!-- Inicialmente, no visible, mostrará un mensaje cuando se produzca un error -->
        <!-- No se tiene en cuenta en el layout para centrar correctamente el login y que no quede más abajo -->
        <HBox fx:id="errorCard" alignment="CENTER_LEFT" spacing="10" styleClass="error-card" visible="false" managed="false">
            <Label styleClass="error-icon" text="⚠"/>
            <Label fx:id="errorLabel" styleClass="error-label" wrapText="true" HBox.hgrow="ALWAYS" text=""/>
        </HBox>

        <!-- CARD DE LOGIN -->
        <VBox alignment="CENTER" spacing="15" styleClass="login-card">
            <Label styleClass="titulo" text="K-SURVEYS"/>
            <Label styleClass="subtitulo" text="Introduce tus datos para iniciar sesión">
                <VBox.margin>
                    <Insets bottom="20.0"/>
                </VBox.margin>
            </Label>

            <!-- Username -->
            <TextField fx:id="usernameField" promptText="Introduce tu usuario" styleClass="input-field, icon-user"/>

            <!-- StackPane para sobreponer el botón Ojo a la contraseña -->
            <StackPane>
                <!-- TextField para ver la contraseña -->
                <TextField fx:id="passwordText" managed="false" promptText="Introduce tu contraseña"
                           styleClass="input-field, icon-lock" visible="false"/>

                <!-- PasswordField para ocultar la contraseña -->
                <PasswordField fx:id="passwordField" promptText="Introduce tu contraseña"
                               styleClass="input-field, icon-lock"/>

                <!-- Botón Ojo para ver el contenido de la contraseña -->
                <Button onAction="#togglePassword" styleClass="eye-button">
                    <StackPane.alignment>CENTER_RIGHT</StackPane.alignment>
                </Button>
                <VBox.margin>
                    <Insets bottom="5.0"/>
                </VBox.margin>
            </StackPane>

            <!-- Link Recuperar Contraseña -->
            <HBox alignment="CENTER_LEFT">
                <Hyperlink text="Recuperar contraseña" onAction="#goToResetPassword"/>
            </HBox>

            <!-- Botón Registro -->
            <Button onAction="#handleLogin" styleClass="login-button" text="INICIAR SESIÓN">
                <VBox.margin>
                    <Insets top="15.0"/>
                </VBox.margin>
            </Button>

            <!-- Link Registro -->
            <HBox alignment="CENTER" spacing="5" >
                <Label text="¿No tienes cuenta?" textFill="gray"/>
                <Hyperlink text="Regístrate" onAction="#goToRegister"/>

            </HBox>
        </VBox>
    </VBox>

</StackPane>


