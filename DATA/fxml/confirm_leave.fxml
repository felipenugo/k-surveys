<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="presentation.views.ConfirmLeaveController"
      alignment="CENTER"
      spacing="20"
      styleClass="delete-card">

    <padding>
        <Insets top="25" right="25" bottom="25" left="25"/>
    </padding>

    <Label text="¿Está seguro que desea abandonar la página?"
           styleClass="delete-title" wrapText="true"/>

    <Label text="Sus respuestas NO se guardarán."
           styleClass="delete-subtitle" wrapText="true"/>

    <HBox spacing="20" alignment="CENTER">
        <Button text="Cancelar"
                fx:id="cancelButton"
                onAction="#handleCancel"
                styleClass="cancel-btn"/>

        <Button text="Salir"
                fx:id="leaveButton"
                onAction="#handleLeave"
                styleClass="delete-btn"/>
    </HBox>

</VBox>
