<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           style="-fx-background-color: rgba(0,0,0,0.4);">

    <!-- CARD DEL POPUP -->
    <VBox alignment="CENTER" spacing="20"
          style="-fx-background-color: white; -fx-padding: 30; -fx-background-radius: 15;">

        <Label text="⚠" style="-fx-font-size: 40;" />

        <Label text="¿Estás seguro de que deseas eliminar tu cuenta?"
               wrapText="true"
               style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-alignment: center;"/>

        <Label text="Esta acción es permanente y no se puede deshacer."
               wrapText="true"
               style="-fx-font-size: 14; -fx-text-alignment: center; -fx-text-fill: #666;"/>

        <HBox spacing="15" alignment="CENTER">
            <Button text="Cancelar"
                    prefWidth="120"
                    onAction="#handleCancel"
                    style="-fx-background-color: #cccccc; -fx-text-fill: black; -fx-background-radius: 8;" />

            <Button text="Eliminar"
                    prefWidth="120"
                    onAction="#confirmDelete"
                    style="-fx-background-color: #d9534f; -fx-text-fill: white; -fx-background-radius: 8;" />
        </HBox>
    </VBox>

</StackPane>
