<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<StackPane styleClass="root-pane"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           stylesheets="/css/register.css">

    <VBox alignment="CENTER" spacing="20">

        <HBox fx:id="errorCard" visible="false" managed="false" spacing="10" styleClass="error-card">
            <Label styleClass="error-icon" text="⚠"/>
            <Label fx:id="errorLabel" styleClass="error-label" wrapText="true"/>
        </HBox>

        <VBox alignment="CENTER" spacing="15" styleClass="register-card">

            <Label styleClass="titulo" text="Recuperar Contraseña"/>
            <Label styleClass="subtitulo" text="Introduce tu nombre de usuario"/>

            <TextField fx:id="usernameField" promptText="Nombre de usuario"
                       styleClass="input-field, icon-user"/>

            <Button text="Continuar" onAction="#handleContinue"
                    styleClass="register-button"/>

            <Hyperlink text="Volver" onAction="#goBack"/>

        </VBox>
    </VBox>
</StackPane>
