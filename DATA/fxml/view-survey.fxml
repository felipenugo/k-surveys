<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="main-container" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            stylesheets="/css/surveys.css, /css/create-survey.css, /css/view-survey.css">

    <!-- SIDEBAR -->
    <left>
        <VBox styleClass="side-bar">

            <!-- Perfil -->
            <HBox alignment="CENTER_LEFT" spacing="15.0" styleClass="user-profile">
                <Label fx:id="avatarLabel" alignment="CENTER" text="" styleClass="avatar-circle"/>
                <Label fx:id="usernameLabel" text="" styleClass="username-text"/>
            </HBox>

            <!-- Navegación -->
            <VBox styleClass="nav-bar" spacing="15.0" VBox.vgrow="ALWAYS">
                <VBox.margin>
                    <Insets top="35.0"/>
                </VBox.margin>

                <!-- Botón de Inicio -->
                <Button fx:id="home" styleClass="nav-btn, icon, icon-home" text="Inicio" maxWidth="Infinity"
                        alignment="BASELINE_LEFT" onAction="#goToHome"/>

                <!-- Botón de Mis Encuestas (activo) -->
                <Button fx:id="mySurveys" styleClass="nav-btn, icon, icon-survey" text="Mis Encuestas"
                        maxWidth="Infinity" alignment="BASELINE_LEFT" onAction="#goToMySurveys"/>

                <!-- Botón de Mis Borradores -->
                <Button fx:id="myDrafts" styleClass="nav-btn, icon, icon-draft" text="Mis Borradores"
                        maxWidth="Infinity" alignment="BASELINE_LEFT" onAction="#goToMyDrafts"/>

                <!-- Botón de Crear Encuesta -->
                <Button fx:id="createSurvey" styleClass="nav-btn, create-btn, icon, icon-create"
                        text="Crear Encuesta" maxWidth="Infinity"
                        alignment="BASELINE_LEFT" onAction="#goToCreateSurvey">
                    <VBox.margin>
                        <Insets bottom="15.0"/>
                    </VBox.margin>
                </Button>

                <!-- Empujar contenido abajo -->
                <Region VBox.vgrow="ALWAYS"/>

                <!-- Botón de Cerrar Sesión -->
                <Button styleClass="nav-btn, icon, icon-logout" text="Cerrar Sesión" maxWidth="Infinity"
                        alignment="BASELINE_LEFT" onAction="#handleLogout"/>
            </VBox>
        </VBox>
    </left>

    <!-- CONTENIDO CENTRAL -->
    <center>
        <VBox alignment="TOP_CENTER" styleClass="content-area" BorderPane.alignment="CENTER">

            <ScrollPane fx:id="scrollPane" fitToWidth="true" styleClass="scroll-pane-transparent" VBox.vgrow="ALWAYS">
                <content>
                    <VBox alignment="TOP_CENTER" spacing="20" styleClass="content-container" maxWidth="Infinity">
                        <padding>
                            <Insets top="40" right="40" bottom="120" left="40"/>
                        </padding>

                        <!-- HEADER DE LA ENCUESTA -->
                        <VBox styleClass="survey-view-header" spacing="15" maxWidth="Infinity">
                            <!-- Título y estado -->
                            <HBox alignment="CENTER_LEFT" spacing="15">
                                <Label fx:id="surveyTitleLabel" text="Título de la Encuesta" styleClass="survey-view-title"/>
                                <Label fx:id="statusBadge" text="PUBLICADA" styleClass="status-badge-published"/>
                            </HBox>

                            <!-- Descripción -->
                            <Label fx:id="surveyDescLabel" text="Descripción de la encuesta"
                                   styleClass="survey-view-desc" wrapText="true"/>

                            <!-- Estadísticas -->
                            <HBox styleClass="stats-container" spacing="30">
                                <VBox alignment="CENTER" styleClass="stat-box">
                                    <Label fx:id="viewsCountLabel" text="0" styleClass="stat-number"/>
                                    <Label text="Vistas" styleClass="stat-label"/>
                                </VBox>
                                <VBox alignment="CENTER" styleClass="stat-box">
                                    <Label fx:id="responsesCountLabel" text="0" styleClass="stat-number"/>
                                    <Label text="Respuestas" styleClass="stat-label"/>
                                </VBox>
                                <VBox alignment="CENTER" styleClass="stat-box">
                                    <Label fx:id="ratingLabel" text="0.0" styleClass="stat-number"/>
                                    <Label text="Valoración" styleClass="stat-label"/>
                                </VBox>
                                <VBox alignment="CENTER" styleClass="stat-box">
                                    <Label fx:id="createdDateLabel" text="--/--/----" styleClass="stat-number-small"/>
                                    <Label text="Creada" styleClass="stat-label"/>
                                </VBox>
                                <VBox alignment="CENTER" styleClass="stat-box">
                                    <Label fx:id="publishedDateLabel" text="--/--/----" styleClass="stat-number-small"/>
                                    <Label text="Publicada" styleClass="stat-label"/>
                                </VBox>
                            </HBox>
                        </VBox>

                        <!-- SEPARADOR -->
                        <HBox styleClass="section-separator">
                            <Label text="PREGUNTAS DE LA ENCUESTA" styleClass="section-title"/>
                        </HBox>

                        <!-- LISTA DE PREGUNTAS (Solo lectura) -->
                        <VBox fx:id="questionsContainer" spacing="15" alignment="TOP_CENTER">
                            <!-- Las preguntas se generan dinámicamente desde Java -->
                        </VBox>

                        <!-- Espacio extra al final -->
                        <Region minHeight="60"/>

                    </VBox>
                </content>
            </ScrollPane>
        </VBox>
    </center>

    <!-- BARRA INFERIOR -->
    <bottom>
        <HBox styleClass="bottom-bar" alignment="CENTER" spacing="15" BorderPane.alignment="CENTER">
            <Button text="← Volver a Mis Encuestas" styleClass="btn-back" onAction="#handleBack"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Exportar CSV" styleClass="btn-export" onAction="#handleExportCSV"/>
            <Button text="Ejecutar Clustering" styleClass="btn-clustering" onAction="#handleRunClustering"/>
            <Button text="Cerrar Encuesta" styleClass="btn-close-survey" onAction="#handleCloseSurvey"/>
        </HBox>
    </bottom>

</BorderPane>

