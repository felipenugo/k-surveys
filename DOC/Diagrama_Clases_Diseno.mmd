---
config:
  theme: redux
  look: neo
---
classDiagram
direction LR
    %% ========== CAPA DE DOMINIO ==========
    
    class User {
        - username: String
        - email: String
        - password: String
        - createdSurveysId: Set~String~
        - respondedSurveysId: Map~String, Set~String~~
        + User(username: String, email: String, password: String)
        + getUsername(): String
        + getEmail(): String
        + setEmail(email: String): void
        + getPassword(): String
        + setPassword(password: String): void
        + getCreatedSurveysId(): Set~String~
        + getRespondedSurveysId(): Map~String, Set~String~~
        + addCreatedSurvey(surveyId: String): void
        + removeCreatedSurvey(surveyId: String): void
        + addRespondedSurvey(surveyId: String, responseId: String): void
        + removeRespondedSurvey(surveyId: String, responseId: String): void
    }

    %% ========== ENCUESTAS Y PREGUNTAS ==========
    
    class Survey {
        - SURVEY_ID: String
        - title: String
        - description: String
        - CREATOR_USERNAME: String
        - CREATED_AT: LocalDateTime
        - PUBLISHED_AT: LocalDateTime
        - surveyStatus: SurveyStatus
        - avgRating: Double
        - views: Integer
        - questions: List~Question~
        + Survey(surveyId: String, title: String, description: String, creatorUsername: String)
        + Survey(title: String, description: String, creatorUsername: String)
        + getSURVEY_ID(): String
        + getTitle(): String
        + setTitle(title: String): void
        + getDescription(): String
        + setDescription(description: String): void
        + getCreatorUsername(): String
        + getCreatedAt(): LocalDateTime
        + getPublishedAt(): LocalDateTime
        + getSurveyStatus(): SurveyStatus
        + setSurveyStatus(status: SurveyStatus): void
        + getAvgRating(): Double
        + setAvgRating(rating: Double): void
        + getViews(): Integer
        + incrementViews(): void
        + getQuestions(): List~Question~
        + addQuestion(question: Question): void
        + removeQuestion(questionIndex: Integer): void
        + getQuestion(questionIndex: Integer): Question
        + reorderQuestions(newOrder: List~Integer~): void
    }

    class Question {
        - questionIndex: Integer
        - SURVEY_ID: String
        - typeQuestion: TypeQuestion
        - questionText: String
        - isRequired: Boolean
        + Question(questionIndex: Integer, surveyId: String)
        + getQuestionIndex(): Integer
        + getSURVEY_ID(): String
        + getTypeQuestion(): TypeQuestion
        + setTypeQuestion(type: TypeQuestion): void
        + getQuestionText(): String
        + setQuestionText(text: String): void
        + isRequired(): Boolean
        + setRequired(required: Boolean): void
    }

    class MultipleChoiceQuestion {
        - minSelections: Integer
        - maxSelections: Integer
        - optionQuestions: List~OptionQuestion~
        + MultipleChoiceQuestion(questionIndex: Integer, surveyId: String)
        + getMinSelections(): Integer
        + setMinSelections(min: Integer): void
        + getMaxSelections(): Integer
        + setMaxSelections(max: Integer): void
        + getOptions(): List~OptionQuestion~
        + getOptionsSize(): Integer
        + addOption(option: OptionQuestion): void
        + removeOption(optionIndex: Integer): void
        + getOption(optionIndex: Integer): OptionQuestion
    }

    class OptionQuestion {
        - questionIndex: Integer
        - surveyId: String
        - optionText: String
        + OptionQuestion(questionIndex: Integer, surveyId: String)
        + getQuestionIndex(): Integer
        + getSurveyId(): String
        + getOptionText(): String
        + setOptionText(text: String): void
        + setQuestionIndex(index: Integer): void
    }

    %% ========== RESPUESTAS ==========
    
    class Response {
        - RESPONSE_ID: String
        - SURVEY_ID: String
        - RESPONDER_USERNAME: String
        - responseStatus: ResponseStatus
        - SUBMITTED_AT: LocalDateTime
        - ANSWERS: Answer[]
        + Response(responseId: String, surveyId: String, responderUsername: String, questions: List~Question~)
        + Response(surveyId: String, responderUsername: String, questions: List~Question~)
        + getRESPONSE_ID(): String
        + getSURVEY_ID(): String
        + getRESPONDER_USERNAME(): String
        + getResponseStatus(): ResponseStatus
        + setResponseStatus(status: ResponseStatus): void
        + getSUBMITTED_AT(): LocalDateTime
        + setSUBMITTED_AT(time: LocalDateTime): void
        + getANSWERS(): Answer[]
        + getAnswer(questionIndex: Integer): Answer
        + setAnswer(questionIndex: Integer, answer: Answer): void
        + isComplete(): Boolean
        + submit(): void
        + toVector(): Object[]
    }

    class Answer {
        <<abstract>>
        - QUESTION_INDEX: Integer
        - RESPONSE_ID: String
        - typeAnswer: TypeQuestion
        - isAnswered: Boolean
        + Answer(questionIndex: Integer, responseId: String, typeAnswer: TypeQuestion)
        + getQUESTION_INDEX(): Integer
        + getResponseId(): String
        + getTypeAnswer(): TypeQuestion
        + getIsAnswered(): Boolean
        + setIsAnswered(answered: Boolean): void
        + clearAnswer(): void*
    }

    class TextualAnswer {
        - answerText: String
        + TextualAnswer(questionIndex: Integer, responseId: String)
        + getAnswerText(): String
        + setAnswerText(text: String): void
        + clearAnswer(): void
    }

    class NumericalAnswer {
        - answerNum: Double
        + NumericalAnswer(questionIndex: Integer, responseId: String)
        + getAnswerNum(): Double
        + setAnswerNum(value: Double): void
        + clearAnswer(): void
    }

    class MultipleChoiceAnswer {
        - maxOptions: Integer
        - selectedOptions: Boolean[]
        + MultipleChoiceAnswer(questionIndex: Integer, responseId: String, maxOptions: Integer)
        + getMaxOptions(): Integer
        + getSelectedOptions(): Boolean[]
        + selectOption(optionIndex: Integer): void
        + deselectOption(optionIndex: Integer): void
        + isOptionSelected(optionIndex: Integer): Boolean
        + getSelectedCount(): Integer
        + clearAnswer(): void
    }

    %% ========== CLUSTERING ==========
    
    class ClusteringAnalysis {
        - id: String
        - surveyId: String
        - k: Integer
        - algorithmType: String
        - analysisDate: LocalDateTime
        - converged: Boolean
        - iterations: Integer
        - executionTime: Long
        - clusters: List~Cluster~
        - algorithm: ClusteringAlgorithm
        - responses: List~Response~
        - questions: List~Question~
        - distance: DistanceCalculator
        + ClusteringAnalysis(survey: Survey, k: Integer, algorithm: ClusteringAlgorithm)
        + getId(): String
        + getSurveyId(): String
        + getK(): Integer
        + getAnalysisDate(): LocalDateTime
        + execute(responses: List~Response~, questions: List~Question~, distance: DistanceCalculator): void
        + getClusters(): List~Cluster~
        + getCluster(clusterId: String): Cluster
        + hasConverged(): Boolean
        + getIterations(): Integer
        + getExecutionTime(): Long
        + calculateQuality(metricType: QualityMetricType): Double
        + getClusterQuality(cluster: Cluster, metricType: QualityMetricType): Double
        + exportResults(): String
    }

    class ClusterResults {
        - clusters: List~Cluster~
        - iterations: Integer
        - converged: Boolean
        + ClusterResults(clusters: List~Cluster~, iterations: Integer, converged: Boolean)
        + getClusters(): List~Cluster~
        + getCluster(clusterIndex: Integer): Cluster
        + getNumberOfClusters(): Integer
        + getK(): Integer
        + getNumberOfResponses(): Integer
        + getIterations(): Integer
        + hasConverged(): Boolean
        + getClusterAssignments(): Integer[]
    }

    class ClusteringAlgorithm {
        <<interface>>
        + execute(responses: List~Response~, questions: List~Question~, k: Integer, distance: DistanceCalculator): ClusterResults*
        + getName(): String
        + getDescription(): String
    }

    class KMeans {
        - maxIterations: Integer
        - tolerance: Double
        - randomSeed: Long
        + KMeans(maxIterations: Integer, tolerance: Double)
        + execute(responses: List~Response~, questions: List~Question~, k: Integer, distance: DistanceCalculator): ClusterResults
        + getName(): String
        + getDescription(): String
        - initializeCentroids(responses: List~Response~, k: Integer): List~Centroid~
        - assignToClusters(responses: List~Response~, centroids: List~Centroid~, distance: DistanceCalculator): void
        - updateCentroids(clusters: List~Cluster~, questions: List~Question~): void
        - hasConverged(oldCentroids: List~Centroid~, newCentroids: List~Centroid~): Boolean
    }

    class KMeansPlusPlus {
        - maxIterations: Integer
        - tolerance: Double
        - randomSeed: Long
        + KMeansPlusPlus(maxIterations: Integer, tolerance: Double)
        + execute(responses: List~Response~, questions: List~Question~, k: Integer, distance: DistanceCalculator): ClusterResults
        + getName(): String
        + getDescription(): String
        - initializeCentroidsPlusPlus(responses: List~Response~, questions: List~Question~, k: Integer, distance: DistanceCalculator): List~Centroid~
    }

    class KMedoids {
        - maxIterations: Integer
        - tolerance: Double
        - randomSeed: Long
        + KMedoids(maxIterations: Integer, tolerance: Double)
        + execute(responses: List~Response~, questions: List~Question~, k: Integer, distance: DistanceCalculator): ClusterResults
        + getName(): String
        + getDescription(): String
        - initializeMedoids(responses: List~Response~, k: Integer): List~Integer~
        - findBestMedoid(responses: List~Response~, clusterIndices: List~Integer~, distance: DistanceCalculator): Integer
    }

    class Cluster {
        - id: String
        - label: String
        - centroid: Centroid
        - members: List~ClusterMembership~
        + Cluster(id: String)
        + getId(): String
        + getLabel(): String
        + setLabel(label: String): void
        + getCentroid(): Centroid
        + setCentroid(centroid: Centroid): void
        + addMember(response: Response, distance: Double): void
        + removeMember(responseId: String): Boolean
        + getMembers(): List~ClusterMembership~
        + getSize(): Integer
        + contains(responseId: String): Boolean
        + getAverageDistance(): Double
    }

    class Centroid {
        - components: List~Object~
        + Centroid()
        + Centroid(components: List~Object~)
        + getComponents(): List~Object~
        + setComponents(components: List~Object~): void
        + setComponent(index: Integer, value: Object): void
        + getComponent(index: Integer): Object
        + size(): Integer
        + distanceTo(response: Response, questions: List~Question~, calculator: DistanceCalculator): Double
        + clone(): Centroid
    }

    class ClusterMembership {
        - responseId: String
        - clusterId: String
        - distance: Double
        + ClusterMembership(response: Response, cluster: Cluster, distance: Double)
        + getResponseId(): String
        + getClusterId(): String
        + getDistance(): Double
        + setDistance(distance: Double): void
    }

    %% ========== DISTANCIAS ==========
    
    class DistanceCalculator {
        - distanceType: DistanceType
        + DistanceCalculator(distanceType: DistanceType)
        + calculate(r1: Response, r2: Response, questions: List~Question~): Double
        + calculateToCentroid(response: Response, centroid: Centroid, questions: List~Question~): Double
        - calculateAnswerDistance(a1: Answer, a2: Answer, question: Question): Double
        - calculateNumericDistance(a1: NumericalAnswer, a2: NumericalAnswer): Double
        - calculateTextualDistance(a1: TextualAnswer, a2: TextualAnswer): Double
        - calculateMultipleChoiceDistance(a1: MultipleChoiceAnswer, a2: MultipleChoiceAnswer): Double
        - normalizeDistance(distance: Double, minDist: Double, maxDist: Double): Double
    }

    class DistanceType {
        <<enumeration>>
        EUCLIDEAN
        MANHATTAN
        COSINE
    }

    %% ========== MÉTRICAS DE CALIDAD ==========
    
    class QualityMetricCalculator {
        + QualityMetricCalculator()
        + calculateSilhouette(analysis: ClusteringAnalysis): Double
        + calculateCalinskiHarabasz(analysis: ClusteringAnalysis): Double
        + calculateDaviesBouldin(analysis: ClusteringAnalysis): Double
        + calculateClusterSilhouette(cluster: Cluster, allClusters: List~Cluster~, distance: DistanceCalculator, responses: List~Response~, questions: List~Question~): Double
        + interpretScore(metricType: QualityMetricType, score: Double): String
        - calculateCohesion(cluster: Cluster, distance: DistanceCalculator, responses: List~Response~, questions: List~Question~): Double
        - calculateSeparation(cluster: Cluster, otherClusters: List~Cluster~, distance: DistanceCalculator, responses: List~Response~, questions: List~Question~): Double
    }

    class QualityMetricType {
        <<enumeration>>
        SILHOUETTE
        CALINSKI_HARABASZ
        DAVIES_BOULDIN
    }

    %% ========== ENUMERACIONES ==========
    
    class SurveyStatus {
        <<enumeration>>
        DRAFT
        PUBLISHED
        CLOSED
    }

    class ResponseStatus {
        <<enumeration>>
        DRAFT
        SUBMITTED
    }

    class TypeQuestion {
        <<enumeration>>
        TEXTUAL
        MULTIPLE_CHOICE
        NUMERICAL
    }

    %% ========== CONTROLADORES (GESTIÓN) ==========
    
    class SurveyController {
        - surveyService: SurveyService
        + SurveyController(surveyService: SurveyService)
        + createSurvey(survey: Survey): Survey
        + initializeNewSurvey(title: String, description: String, creatorUsername: String): Survey
        + getSelectedSurveys(): List~Survey~
        + getSurveysId(): List~String~
        + getSurvey(surveyId: String): Survey
        + getMySurveys(): List~Survey~
        + existsSurvey(surveyId: String): Boolean
        + incrementResponseCount(surveyId: String): void
    }

    class QuestionController {
        - questionService: QuestionService
        + QuestionController(questionService: QuestionService)
        + createQuestion(question: Question): Question
        + createMultipleChoiceQuestion(questionIndex: Integer, surveyId: String): MultipleChoiceQuestion
        + getQuestion(surveyId: String, questionIndex: Integer): Question
        + updateQuestion(question: Question): void
        + deleteQuestion(surveyId: String, questionIndex: Integer): void
    }

    class ResponseController {
        - responseService: ResponseService
        + ResponseController(responseService: ResponseService)
        + createResponse(response: Response): Response
        + initializeNewResponse(surveyId: String, responderUsername: String, questions: List~Question~): Response
        + getResponse(responseId: String): Response
        + getResponsesBySurveyId(surveyId: String): List~Response~
        + getResponsesByUser(username: String): List~Response~
        + updateResponse(response: Response): void
        + deleteResponse(responseId: String): void
        + submitResponse(responseId: String): void
    }

    class AnswerController {
        - answerService: AnswerService
        + AnswerController(answerService: AnswerService)
        + createAnswer(answer: Answer): Answer
        + getAnswer(responseId: String, questionIndex: Integer): Answer
        + updateAnswer(answer: Answer): void
        + clearAnswer(responseId: String, questionIndex: Integer): void
    }

    class UserController {
        - userService: UserService
        + UserController(userService: UserService)
        + registerUser(user: User): User
        + loginUser(username: String, password: String): User
        + getUser(username: String): User
        + updateUser(user: User): void
        + deleteUser(username: String): void
    }

    class AnalysisController {
        - analyses: Map~String, ClusteringAnalysis~
        - metricCalculator: QualityMetricCalculator
        + AnalysisController()
        + createAnalysis(survey: Survey, k: Integer, algorithmType: String, config: Map~String, Object~): ClusteringAnalysis
        + createAlgorithm(type: String, config: Map~String, Object~): ClusteringAlgorithm
        + getAnalysis(id: String): ClusteringAnalysis
        + getAnalysesByQuestionSet(surveyId: String): List~ClusteringAnalysis~
        + executeAnalysis(id: String, responses: List~Response~, questions: List~Question~, distance: DistanceCalculator): void
        + calculateQuality(id: String, metricType: QualityMetricType): Double
        + deleteAnalysis(id: String): Boolean
        + getAvailableAlgorithms(): List~String~
    }

    class CtrlDominioClustering {
        - analysisController: AnalysisController
        - responseRepository: ResponseRepository
        - surveyRepository: SurveyRepository
        + CtrlDominioClustering(responseRepository: ResponseRepository, surveyRepository: SurveyRepository)
        + runAnalysis(algorithmName: String, surveyId: String, k: Integer, maxIter: Integer, tolerance: Double, distanceMetric: String): String
        + exportarAnalisis(analysisId: String, filePath: String): String
        + obtenerMetricasCalidad(analysisId: String): String
        + determinarKOptimo(surveyId: String, minK: Integer, maxK: Integer, algorithmName: String): Integer
        + listarAnalisis(): List~String~
        + obtenerResumenAnalisis(analysisId: String): String
        + obtenerInfoCluster(analysisId: String, clusterId: String): String
    }

    %% ========== REPOSITORIOS ==========
    
    class SurveyRepository {
        - surveys: Map~String, Survey~
        - nextSurveyId: Integer
        + SurveyRepository()
        + addSurvey(survey: Survey): void
        + deleteSurvey(surveyId: String): void
        + getSurvey(surveyId: String): Survey
        + getAllSurveys(): List~Survey~
        + getAllSurveysId(): List~String~
        + updateSurvey(surveyId: String, updatedSurvey: Survey): void
        + existsSurvey(surveyId: String): Boolean
        + generateSurveyId(): String
    }

    class QuestionRepository {
        - questions: Map~String, Question~
        + QuestionRepository()
        + addQuestion(question: Question): void
        + deleteQuestion(surveyId: String, questionIndex: Integer): void
        + getQuestion(surveyId: String, questionIndex: Integer): Question
        + getQuestionsBySurveyId(surveyId: String): List~Question~
        + updateQuestion(question: Question): void
    }

    class ResponseRepository {
        - responses: Map~String, Response~
        - nextResponseId: Integer
        + ResponseRepository()
        + addResponse(response: Response): void
        + deleteResponse(responseId: String): void
        + getResponse(responseId: String): Response
        + getResponsesBySurveyId(surveyId: String): List~Response~
        + getResponsesByUsername(username: String): List~Response~
        + getAllResponses(): List~Response~
        + updateResponse(response: Response): void
        + generateResponseId(): String
    }

    class AnswerRepository {
        - answers: Map~String, Answer~
        + AnswerRepository()
        + addAnswer(answer: Answer): void
        + deleteAnswer(responseId: String, questionIndex: Integer): void
        + getAnswer(responseId: String, questionIndex: Integer): Answer
        + getAnswersByResponseId(responseId: String): List~Answer~
        + updateAnswer(answer: Answer): void
    }

    class UserRepository {
        - users: Map~String, User~
        + UserRepository()
        + addUser(user: User): void
        + deleteUser(username: String): void
        + getUser(username: String): User
        + getAllUsers(): List~User~
        + updateUser(user: User): void
        + existsUser(username: String): Boolean
    }

    %% ========== RELACIONES DE HERENCIA ==========
    
    Question <|-- MultipleChoiceQuestion
    
    Answer <|-- TextualAnswer
    Answer <|-- NumericalAnswer
    Answer <|-- MultipleChoiceAnswer
    
    ClusteringAlgorithm <|.. KMeans
    ClusteringAlgorithm <|.. KMeansPlusPlus
    ClusteringAlgorithm <|.. KMedoids

    %% ========== RELACIONES DE ASOCIACIÓN ==========
    
    %% Gestión de Surveys
    Survey "1" -- "1" User : createdBy
    Survey "1" *-- "1..*" Question : contains
    SurveyController "1" -- "0..*" Survey : manages
    SurveyController "1" -- "1" SurveyRepository : uses
    
    %% Preguntas de opción múltiple
    MultipleChoiceQuestion "1" *-- "0..*" OptionQuestion : has
    QuestionController "1" -- "0..*" Question : manages
    QuestionController "1" -- "1" QuestionRepository : uses
    
    %% Gestión de respuestas
    Response "1" *-- "0..*" Answer : contains
    Response "1" -- "1" Survey : responseTo
    Response "1" -- "1" User : submittedBy
    Answer "1" -- "1" Question : answersTo
    ResponseController "1" -- "0..*" Response : manages
    ResponseController "1" -- "1" ResponseRepository : uses
    
    %% Gestión de respuestas individuales
    AnswerController "1" -- "0..*" Answer : manages
    AnswerController "1" -- "1" AnswerRepository : uses
    
    %% Gestión de usuarios
    UserController "1" -- "0..*" User : manages
    UserController "1" -- "1" UserRepository : uses
    
    %% Análisis y clustering
    ClusteringAnalysis "1" -- "1" Survey : analyzes
    ClusteringAnalysis "1" -- "1" ClusteringAlgorithm : uses
    ClusteringAnalysis "1" *-- "0..*" Cluster : contains
    ClusteringAnalysis "1" -- "0..1" ClusterResults : produces
    ClusterResults "1" -- "1..*" Cluster : references
    Cluster "1" *-- "1" Centroid : has
    Cluster "1" *-- "0..*" ClusterMembership : contains
    ClusterMembership "1" -- "1" Response : assigns
    AnalysisController "1" -- "0..*" ClusteringAnalysis : manages
    AnalysisController "1" -- "1" QualityMetricCalculator : uses
    
    %% Controlador de clustering directo
    CtrlDominioClustering "1" -- "1" AnalysisController : uses
    CtrlDominioClustering "1" -- "1" ResponseRepository : uses
    CtrlDominioClustering "1" -- "1" SurveyRepository : uses
    
    %% Distancias
    DistanceCalculator "1" -- "1" DistanceType : uses
    KMeans "1" -- "1" DistanceCalculator : uses
    KMeansPlusPlus "1" -- "1" DistanceCalculator : uses
    KMedoids "1" -- "1" DistanceCalculator : uses
    
    %% Métricas
    QualityMetricCalculator "1" -- "1" QualityMetricType : calculates

    %% ========== NOTAS DE DISEÑO ==========
    %% note for MultipleChoiceQuestion "Hereda de Question y contiene lista de OptionQuestion"
    %% note for Answer "Clase abstracta para respuestas individuales a preguntas"
    %% note for Response "Contiene array de Answer, una por cada pregunta de la encuesta"
    %% note for QualityMetricCalculator "Clase de utilidad que calcula múltiples métricas sin jerarquía"
    %% note for ClusteringAlgorithm "Patrón Strategy para intercambiar algoritmos"
    %% note for CtrlDominioClustering "Controlador especializado que usa AnalysisController internamente"
    %% note for SurveyRepository "Repositorios son clases concretas, no interfaces"