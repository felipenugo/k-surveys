---
config:
  theme: redux
  look: neo
---
classDiagram
direction LR
    %% ========== USUARIOS ==========
    class User {
        - id: String
        - username: String
        - email: String
    }

    %% ========== CONJUNTOS DE PREGUNTAS ==========
    class QuestionSet {
        - id: String
        - title: String
        - description: String
        - draft: Boolean
        - creationDate: Date
    }

    class Question {
        <<abstract>>
        - id: String
        - prompt: String
        - required: Boolean
        - order: Integer
    }

    class ChoiceQuestion {
        - options: Set~String~
        - maxSelections: Integer
        - minSelections: Integer
    }

    class OpenQuestion {
        - maxLength: Integer
        - onlyNumbers: Boolean
        - minValue: Double
        - maxValue: Double
    }

    %% ========== RESPUESTAS ==========
    class ResponseSet {
        - id: String
        - submissionDate: Date
        - isComplete: Boolean
    }

    class Response {
        <<abstract>>
        - id: String
        - answered: Boolean
    }

    class TextResponse {
        - values: Set~String~
    }

    class NumericResponse {
        - values: Set~Double~
    }

    %% ========== CLUSTERING Y ANÁLISIS ==========
    class ClusteringAnalysis {
        - id: String
        - k: Integer
        - algorithmType: String
        - executionDate: Date
        - converged: Boolean
        - iterations: Integer
        - qualityScore: Double
    }

    class ClusterResults {
        - clusterAssignments: Integer[]
        - distances: Double[]
        - centroidMatrix: Object[][]
        - dataMatrix: Object[][]
        + getClusterForResponse(responseIndex: Integer): Integer
        + getDistanceForResponse(responseIndex: Integer): Double
        + getCentroid(clusterIndex: Integer): Object[]
        + getResponseData(responseIndex: Integer): Object[]
        + getResponsesInCluster(clusterIndex: Integer): Integer[]
    }

    class ClusteringAlgorithm {
        <<interface>>
    }

    class KMeans {
        - maxIterations: Integer
        - tolerance: Double
    }
    
    class KMeansPlusPlus {
        - maxIterations: Integer
        - tolerance: Double
        - useAsInitOnly: Boolean
    }
    
    class KMedoids {
        - maxIterations: Integer
        - tolerance: Double
    }

    class Cluster {
        - id: String
        - label: String
        - centroid: Centroid
    }

    class Centroid {
        - components: List~Object~
    }

    class ClusterMembership {
        - distance: Double
    }

    %% ========== RELACIONES DE HERENCIA ==========
    Question <|-- ChoiceQuestion
    Question <|-- OpenQuestion
    
    Response <|-- TextResponse
    Response <|-- NumericResponse
    
    ClusteringAlgorithm <|.. KMeans
    ClusteringAlgorithm <|.. KMeansPlusPlus
    ClusteringAlgorithm <|.. KMedoids

    %% ========== RELACIONES DE ASOCIACIÓN ==========
    
    %% Usuario crea conjuntos de preguntas
    User "1" -- "0..*" QuestionSet : creates >
    
    %% Usuario responde
    User "1" -- "0..*" ResponseSet : submits >
    
    %% QuestionSet contiene preguntas
    QuestionSet "1" *-- "1..*" Question : contains >
    
    %% QuestionSet recibe respuestas
    QuestionSet "1" -- "0..*" ResponseSet : receives >
    
    %% ResponseSet contiene respuestas
    ResponseSet "1" *-- "0..*" Response : contains >
    
    %% Respuesta corresponde a una pregunta
    Response "0..*" -- "1" Question : answersTo >
    
    %% Análisis se realiza sobre un QuestionSet
    QuestionSet "1" -- "0..*" ClusteringAnalysis : analyzedBy >
    
    %% Análisis usa un algoritmo
    ClusteringAnalysis "1" -- "1" ClusteringAlgorithm : uses >
    
    %% Análisis produce resultados matriciales
    ClusteringAnalysis "1" *-- "1" ClusterResults : produces >
    
    %% Resultados referencian clusters
    ClusterResults "1" -- "1..*" Cluster : references >
    
    %% Cluster tiene centroide embebido
    Cluster "1" *-- "1" Centroid : has >
    
    %% Asignación de ResponseSets a Clusters
    ResponseSet "0..*" -- "0..1" ClusterMembership : assignedVia >
    Cluster "1" -- "0..*" ClusterMembership : contains >

    %% ========== NOTAS ==========
    %% note for ChoiceQuestion "Puede tener una sola opción\npara simular texto libre"
    %% note for OpenQuestion "Si onlyNumbers=true,\nse espera NumericResponse"
    %% note for ClusteringAnalysis "qualityScore almacena\nla métrica principal (ej: Silhouette)"
    %% note for ClusteringAlgorithm "Patrón Strategy para\nintercambiar algoritmos"