---
config:
  theme: redux
  look: neo
---
classDiagram
direction LR
    %% ========== USUARIOS ==========
    class User {
        - username: String
        - email: String
        - password: String
        - createdSurveysId: Set~String~
        - respondedSurveysId: Map~String, Set~String~~
    }

    %% ========== CONJUNTOS DE PREGUNTAS (ENCUESTAS) ==========
    class Survey {
        - surveyId: String
        - title: String
        - description: String
        - creatorUsername: String
        - createdAt: LocalDateTime
        - publishedAt: LocalDateTime
        - surveyStatus: SurveyStatus
        - avgRating: Double
        - views: Integer
        - questions: List~Question~
    }

    class Question {
        - questionIndex: Integer
        - surveyId: String
        - typeQuestion: TypeQuestion
        - questionText: String
        - isRequired: Boolean
    }

    class MultipleChoiceQuestion {
        - minSelections: Integer
        - maxSelections: Integer
        - optionQuestions: List~OptionQuestion~
    }

    class OptionQuestion {
        - questionIndex: Integer
        - surveyId: String
        - optionText: String
    }

    %% ========== RESPUESTAS ==========
    class Response {
        - responseId: String
        - surveyId: String
        - responderUsername: String
        - responseStatus: ResponseStatus
        - submittedAt: LocalDateTime
        - answers: Answer[]
    }

    class Answer {
        <<abstract>>
        - questionIndex: Integer
        - responseId: String
        - typeAnswer: TypeQuestion
        - isAnswered: Boolean
    }

    class TextualAnswer {
        - answerText: String
    }

    class NumericalAnswer {
        - answerNum: Double
    }

    class MultipleChoiceAnswer {
        - maxOptions: Integer
        - selectedOptions: Boolean[]
    }

    %% ========== CLUSTERING Y ANÁLISIS ==========
    class ClusteringAnalysis {
        - id: String
        - surveyId: String
        - k: Integer
        - algorithmType: String
        - analysisDate: LocalDateTime
        - converged: Boolean
        - iterations: Integer
        - executionTime: Long
        - clusters: List~Cluster~
    }

    class ClusterResults {
        - clusters: List~Cluster~
        - iterations: Integer
        - converged: Boolean
        + getClusters(): List~Cluster~
        + getCluster(clusterIndex: Integer): Cluster
        + getNumberOfClusters(): Integer
        + getNumberOfResponses(): Integer
        + getIterations(): Integer
        + hasConverged(): Boolean
    }

    class ClusteringAlgorithm {
        <<interface>>
        + execute(responses: List~Response~, questions: List~Question~, k: Integer, distance: DistanceCalculator): ClusterResults
        + getName(): String
        + getDescription(): String
    }

    class KMeans {
        - maxIterations: Integer
        - tolerance: Double
    }
    
    class KMeansPlusPlus {
        - maxIterations: Integer
        - tolerance: Double
        - useAsInitOnly: Boolean
    }
    
    class KMedoids {
        - maxIterations: Integer
        - tolerance: Double
    }

    class Cluster {
        - id: String
        - label: String
        - centroid: Centroid
        - members: List~ClusterMembership~
    }

    class Centroid {
        - components: List~Object~
    }

    class ClusterMembership {
        - responseId: String
        - clusterId: String
        - distance: Double
    }

    %% ========== ENUMERACIONES ==========
    class SurveyStatus {
        <<enumeration>>
        DRAFT
        PUBLISHED
        CLOSED
    }

    class ResponseStatus {
        <<enumeration>>
        DRAFT
        SUBMITTED
    }

    class TypeQuestion {
        <<enumeration>>
        TEXTUAL
        MULTIPLE_CHOICE
        NUMERICAL
    }

    class DistanceType {
        <<enumeration>>
        EUCLIDEAN
        MANHATTAN
        COSINE
    }

    class QualityMetricType {
        <<enumeration>>
        SILHOUETTE
        CALINSKI_HARABASZ
        DAVIES_BOULDIN
    }

    %% ========== RELACIONES DE HERENCIA ==========
    Question <|-- MultipleChoiceQuestion
    
    Answer <|-- TextualAnswer
    Answer <|-- NumericalAnswer
    Answer <|-- MultipleChoiceAnswer
    
    ClusteringAlgorithm <|.. KMeans
    ClusteringAlgorithm <|.. KMeansPlusPlus
    ClusteringAlgorithm <|.. KMedoids

    %% ========== RELACIONES DE ASOCIACIÓN ==========
    
    %% Usuario crea encuestas
    User "1" -- "0..*" Survey : creates >
    
    %% Usuario responde
    User "1" -- "0..*" Response : submits >
    
    %% Survey contiene preguntas
    Survey "1" *-- "1..*" Question : contains >
    
    %% Survey recibe respuestas
    Survey "1" -- "0..*" Response : receives >
    
    %% MultipleChoiceQuestion contiene opciones
    MultipleChoiceQuestion "1" *-- "0..*" OptionQuestion : has >
    
    %% Response contiene respuestas individuales
    Response "1" *-- "0..*" Answer : contains >
    
    %% Respuesta corresponde a una pregunta
    Answer "0..*" -- "1" Question : answersTo >
    
    %% Análisis se realiza sobre una Survey
    Survey "1" -- "0..*" ClusteringAnalysis : analyzedBy >
    
    %% Análisis usa un algoritmo
    ClusteringAnalysis "1" -- "1" ClusteringAlgorithm : uses >
    
    %% Análisis contiene clusters
    ClusteringAnalysis "1" *-- "1..*" Cluster : contains >
    
    %% Análisis produce resultados
    ClusteringAnalysis "1" -- "1" ClusterResults : produces >
    
    %% Resultados referencian clusters
    ClusterResults "1" -- "1..*" Cluster : references >
    
    %% Cluster tiene centroide
    Cluster "1" *-- "1" Centroid : has >
    
    %% Asignación de Responses a Clusters
    Response "0..*" -- "0..1" ClusterMembership : assignedVia >
    Cluster "1" -- "0..*" ClusterMembership : contains >

    %% ========== NOTAS ==========
    %% note for MultipleChoiceQuestion "Contiene opciones definidas en OptionQuestion"
    %% note for Answer "Respuestas individuales a preguntas específicas"
    %% note for Response "Contiene todas las respuestas de un usuario a una encuesta"
    %% note for ClusteringAlgorithm "Patrón Strategy para\nintercambiar algoritmos"